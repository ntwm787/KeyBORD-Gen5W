[nemesis]
version=1.1
id=keyboard.hackers
name=Hacker's Keyboard
type=application
package-version=2.0.2
short-desc="Open-source keyboard for NEMESIS apps; no Google services."
detailed-desc="Standalone open-source keyboard APK, like Gboard or SwiftKey, with no Google Play Services dependency. Enables typing in NEMESIS-installed apps on Gen5W across vehicle models. Install KeyBridge to activate."
os=*S5W_M*
models=any
depends=""
preinstall=scripts/pre.sh
postinstall=scripts/post.sh
preuninstall=scripts/preun.sh

[app.0]
kind=apk
path=app/HackersKeyboard.apk
package=org.pocketworkstation.pckeyboard
