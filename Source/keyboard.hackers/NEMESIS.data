[nemesis]
version=1.1
id=keyboard.hackers
name=Hacker's Keyboard
type=application
package-version=2.0.1
short-desc="Open-source keyboard for NEMESIS apps; no Google services."
detailed-desc="Hacker's Keyboard is a standalone, open-source Android keyboard APK, like Gboard or SwiftKey, with no Google Play Services dependency. It enables typing in NEMESIS-installed apps where Hyundai's keyboard is unavailable. Activate with KeyBridge."
os=NEEV*
models=neev*
depends=""
preinstall=scripts/pre.sh
postinstall=scripts/post.sh
preuninstall=scripts/preun.sh

[app.0]
kind=apk
path=app/HackersKeyboard.apk
package=org.pocketworkstation.pckeyboard
