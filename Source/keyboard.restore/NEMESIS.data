[nemesis]
version=1.1
id=keyboard.restore
name=Hyundai Keyboard Restore
type=application
package-version=2.0.2
short-desc="Selects the factory Hyundai keyboard as the system IME."
detailed-desc="Selects the factory keyboard on Gen5W across vehicle models. Saves the previous input method for restoration on uninstall. Requires the factory diopen keyboard component."
os=*S5W_M*
models=any
depends=""
preinstall=scripts/pre.sh
postinstall=scripts/post.sh
preuninstall=scripts/preun.sh
postuninstall=scripts/cleanup.sh

[app.0]
kind=sh
path=scripts/select.sh
uid=root
