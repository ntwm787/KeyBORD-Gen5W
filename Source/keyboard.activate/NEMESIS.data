[nemesis]
version=1.1
id=keyboard.activate
name=KeyBridge
type=application
package-version=2.0.2
short-desc="Selects Hacker's Keyboard as the system input method."
detailed-desc="Selects Hacker's Keyboard system-wide for NEMESIS-installed apps on Gen5W across vehicle models. Requires the keyboard package. Saves the previous input method for restoration on uninstall."
os=*S5W_M*
models=any
depends="keyboard.hackers@>=2.0.1"
preinstall=scripts/pre.sh
postinstall=scripts/post.sh
preuninstall=scripts/preun.sh
postuninstall=scripts/cleanup.sh

[app.0]
kind=sh
path=scripts/select.sh
uid=root
